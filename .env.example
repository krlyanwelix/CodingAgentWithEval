# model API (OpenAI-compatible). Defaults target DeepSeek.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# sampling per request: keeps tool calls short and steady
#MODEL_MAX_TOKENS=2048
#MODEL_TEMPERATURE=0.3
#MODEL_TOP_P=0.9

# timeouts: hard limit for one non-streaming call, and idle limit for a stream
MODEL_TIMEOUT_MS=180000
STREAM_IDLE_TIMEOUT_MS=120000

# bash path (Windows): uncomment when auto-detection finds the wrong bash.exe
#GIT_BASH_PATH=E:\Git\bin\bash.exe

# where to store the session
SESSION_DB=data/agent.sqlite

# context budget: prompts are fitted under CONTEXT_MAX_INPUT_TOKENS by dropping
# old turns into a digest; long tool results are truncated (and spooled to disk).
CONTEXT_MAX_INPUT_TOKENS=24000
CONTEXT_RESERVE_TOKENS=2048
CONTEXT_KEEP_RECENT_TURNS=3
CONTEXT_TOOL_RESULT_MAX_CHARS=4000
CONTEXT_TOOL_RESULT_HEAD_CHARS=1500
CONTEXT_TOOL_RESULT_TAIL_CHARS=1000
CONTEXT_SPILL_DIR=data/tool-output

# where to find the tools and skills
AGENT_TOOLS_DIR=tools
AGENT_SKILLS_DIR=skills

# harness: capability gate for tool calls. Empty capability list = allow all.
# Values: fs.read,fs.write,shell,network,git.write
#AGENT_CAPABILITIES=fs.read,fs.write,shell
# Auto-approve tool calls at or below this risk (low|medium|high). Unattended runs use high.
#AGENT_AUTO_APPROVE_RISK=low
# Print the [harness] status line on the last tool result of each turn.
#AGENT_STATUS_BAR=1

# harness: completion gate. Checks run before the agent is allowed to answer;
# format: "name=command" separated by ";;".
#AGENT_VERIFY_CHECKS=tests=npm test;;types=npx tsc --noEmit
#AGENT_VERIFY_ATTEMPTS=1

# harness: JSONL trace of every run/tool call (empty = off).
#TRACE_DIR=data/traces

# eval: L2 judge (any OpenAI-compatible endpoint). Disabled when the key is empty.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MODEL=qwen3.8-flash
JUDGE_SAMPLES=3

# web-search
EXA_API_KEY=your-exa-api-key

# Mem0 sidecar: embedded Qdrant + OpenRouter/NVIDIA embeddings.
EMBEDDING_API_KEY=sk-or-v1-your-key
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
MEM0_EMBEDDING_DIMS=2048

# long-term memory identity and local vector index
# Long-term memory service (memory-sidecar.py). The agent speaks HTTP to it.
MEMORY_SERVICE_URL=http://127.0.0.1:8765
MEMORY_USER_ID=local-user
# Scope memories to one checkout; empty derives <repo>-<hash> from the cwd.
MEMORY_PROJECT_ID=
MEMORY_AUTOSTART=true
MEMORY_PYTHON=python
MEMORY_LOG=data/memory-service.log
MEMORY_AUDIT_PATH=data/memory-audit.jsonl
# 0 keeps memories forever; otherwise entries expire after N days.
MEMORY_TTL_DAYS=0
MEMORY_LIMIT=5
MEMORY_MIN_SCORE=0.35
MEMORY_BUDGET_CHARS=900
MEMORY_REQUEST_TIMEOUT_MS=30000
MEMORY_START_TIMEOUT_MS=20000
MEM0_VECTOR_PATH=data/mem0-qdrant
MEM0_COLLECTION=memories

# Mem0 sidecar
MEM0_URL=http://127.0.0.1:8765
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=
MEM0_LLM_MODEL=
MEM0_PORT=8765
MEM0_AUTOSTART=true
MEM0_TELEMETRY=false
# Embeddings: dimensions must match MEM0_EMBEDDING_DIMS (default 2048).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
MEM0_EMBEDDING_DIMS=2048
