{
  "name": "lilpiagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:web": "node dist/server.js",
    "test": "node --import tsx --test src/context.test.ts src/session-store.test.ts src/agent.test.ts src/model.test.ts src/model-config.test.ts src/tools.test.ts eval/proposal.test.ts sandbox/service.test.ts sandbox/control-plane.test.ts sandbox/execd.test.ts",
    "test:docker": "node --import tsx --test sandbox/docker-runtime.test.ts",
    "sandbox": "tsx sandbox/server.ts",
    "sandbox:e2e": "tsx sandbox/e2e.ts",
    "eval": "node --env-file=.env --import tsx eval/run.ts",
    "evolve": "node --env-file=.env --import tsx eval/evolve.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3"
  }
}
